from __future__ import annotations

import logging

from app.services.llm import LLMService


logger = logging.getLogger(__name__)


class IntentClassifier:
    """
    Hybrid intent classifier.

    Strategy:
    1. Fast rule-based detection.
    2. LLM fallback for ambiguous queries.

    Used by PlanningParser before creating PlanningRequest.
    """

    INTENT_KEYWORDS = {
    "company_research": [
        "research",
        "analyze",
        "analysis",
        "company",
        "business",
        "stock",
        "profile",
        "fundamentals",
        "overview",
    ],

    "company_comparison": [
        "compare",
        "comparison",
        "vs",
        "versus",
        "better than",
        "peer",
        "relative",
    ],

    "industry_research": [
        "industry",
        "sector",
        "market",
        "competitive landscape",
        "competition",
        "tam",
        "sam",
        "som",
        "porter",
    ],

    "earnings_analysis": [
        "earnings",
        "quarterly",
        "annual report",
        "10-k",
        "10-q",
        "results",
        "guidance",
        "conference call",
        "transcript",
    ],

    "valuation_analysis": [
        "valuation",
        "dcf",
        "discounted cash flow",
        "price target",
        "multiple",
        "ev/ebitda",
        "ev/sales",
        "pe ratio",
        "p/e",
    ],

    "risk_analysis": [
        "risk",
        "risks",
        "bear case",
        "downside",
        "scenario",
        "sensitivity",
    ],

    "macro_research": [
        "macro",
        "economy",
        "inflation",
        "interest rates",
        "fed",
        "central bank",
        "gdp",
        "recession",
    ],

    "portfolio_research": [
        "portfolio",
        "holdings",
        "allocation",
        "rebalance",
        "diversification",
        "watchlist",
    ],

    "theme_research": [
        "theme",
        "megatrend",
        "artificial intelligence",
        "ai",
        "semiconductors",
        "cloud",
        "cybersecurity",
        "renewable energy",
        "electric vehicles",
        "fintech",
    ],
}

    VALID_INTENTS = {
    "company_research",
    "company_comparison",
    "industry_research",
    "earnings_analysis",
    "valuation_analysis",
    "risk_analysis",
    "macro_research",
    "portfolio_research",
    "theme_research",
    "general",
}


    def __init__(self, llm_service: LLMService):
        self.llm_service = llm_service


    def classify(self, text: str) -> str:
        """
        Classify user intent.
        """

        normalized = text.lower().strip()


        # Rule based fast path
        for intent, keywords in self.INTENT_KEYWORDS.items():

            for keyword in keywords:

                if keyword in normalized:
                    return intent


        # LLM fallback
        return self._llm_classify(text)



    def _llm_classify(self, query: str) -> str:

        prompt = f"""
You are an intent classifier.

Classify the user query into exactly one category.

Available intents:

- research
- comparison
- company_analysis
- startup_analysis
- architecture
- general


Rules:
Return ONLY the intent name.
No explanation.


Query:
{query}
"""


        try:

            response = (
                self.llm_service
                .generate(prompt)
                .strip()
                .lower()
            )


            if response in self.VALID_INTENTS:
                return response


        except Exception as e:

            logger.error(
                "LLM intent classification failed: %s",
                e
            )


        return "general"